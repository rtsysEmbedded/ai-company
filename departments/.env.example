# OpenRouter keys for the departments run by the department engine (not the software department,
# which keeps its keys in the company folder's own .env). Easiest: set them in the web interface.
# This file must stay private: chmod 600 .env

# Shared by every department that has no key of its own:
OPENROUTER_API_KEY=

# Optional: one department's own key (its own spending limit), e.g. for departments/hardware:
# OPENROUTER_API_KEY_HARDWARE=
# Optional: one role's own key, e.g. for hw-lead:
# OPENROUTER_API_KEY_HW_LEAD=
