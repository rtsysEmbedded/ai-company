<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aicompany.embedder</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string><string>run</string><string>--project</string><string>__ROOT__</string>
    <string>python</string><string>__ROOT__/services/embedder/server.py</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict><key>HF_HUB_OFFLINE</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/embedder.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/embedder.log</string>
</dict>
</plist>
