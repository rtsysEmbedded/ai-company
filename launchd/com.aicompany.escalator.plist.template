  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/escalator.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/escalator.log</string>
</dict>
</plist>
